<%#
  A form button, not ActiveAdmin's default <a data-method="delete">. That link needs
  jQuery-UJS to turn the click into a DELETE, and this app runs Propshaft with no Sprockets
  and no jQuery, so it silently performed a GET and appeared to do nothing. A form needs no
  JavaScript. The confirm is plain inline JS for the same reason - data-confirm is also UJS.
%>
<%= button_to "Delete",
      admin_agent_release_path(release),
      method: :delete,
      class: "member_link delete_link",
      form: { onsubmit: "return confirm('Delete #{release.version} and remove its installer from R2?')" } %>
