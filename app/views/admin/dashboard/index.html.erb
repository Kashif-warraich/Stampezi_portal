<% content_for :title, "Dashboard · Stampezi" %>

<header class="page-head">
  <div>
    <div class="kicker">Overview</div>
    <h1>Dashboard</h1>
  </div>
</header>

<div class="stats">
  <div class="stat">
    <div class="stat-label">Shops</div>
    <div class="stat-value"><%= @shops_count %></div>
    <div class="stat-hint"><%= @licence_counts.fetch("active", 0) %> with an active licence</div>
  </div>
  <div class="stat">
    <div class="stat-label">Licences</div>
    <div class="stat-value"><%= @licence_counts.values.sum %></div>
    <div class="stat-hint"><%= @licence_counts.fetch("grace", 0) %> in grace · <%= @licence_counts.fetch("expired", 0) %> expired</div>
  </div>
  <div class="stat">
    <div class="stat-label">Files waiting</div>
    <div class="stat-value"><%= @waiting_files %></div>
    <div class="stat-hint">uploaded, not yet printed</div>
  </div>
  <div class="stat">
    <div class="stat-label">Releases</div>
    <div class="stat-value"><%= @releases_count %></div>
    <div class="stat-hint"><%= @installable_count %> installable</div>
  </div>
</div>

<div class="dash-grid">
  <div class="card">
    <div class="card-head">
      <h2 class="card-title">Recent uploads</h2>
    </div>
    <% if @recent_uploads.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Shop</th><th>File</th><th>Status</th><th>Received</th></tr></thead>
          <tbody>
            <% @recent_uploads.each do |upload| %>
              <tr>
                <td><%= link_to upload.shop.name, admin_shop_path(upload.shop), class: "strong" %></td>
                <td><%= upload.file_name %></td>
                <td><%= status_badge upload.status %></td>
                <td><%= fmt_time upload.created_at %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <div class="empty-title">Nothing here yet</div>
        <div class="empty-hint">Uploads appear as customers scan shop QR codes.</div>
      </div>
    <% end %>
  </div>

  <div class="dash-col">
    <div class="card pad">
      <h2 class="card-title">Licences by status</h2>
      <% total = [ @licence_counts.values.sum, 1 ].max %>
      <% { "active" => "var(--teal)", "grace" => "#D97706", "expired" => "var(--red)" }.each do |status, color| %>
        <% count = @licence_counts.fetch(status, 0) %>
        <div class="bar-row">
          <div class="bar-meta">
            <span><%= status.capitalize %></span>
            <span class="mono dim"><%= count %></span>
          </div>
          <div class="bar-track">
            <div class="bar-fill" style="width: <%= (count * 100.0 / total).round %>%; background: <%= color %>;"></div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="card">
      <div class="card-head">
        <h2 class="card-title">Latest releases</h2>
        <%= link_to "View all", admin_agent_releases_path %>
      </div>
      <% if @latest_releases.any? %>
        <% @latest_releases.each do |release| %>
          <div class="list-row">
            <%= link_to release.version, admin_agent_release_path(release), class: "mono strong" %>
            <span class="dim"><%= fmt_date release.published_at %></span>
            <%= release_state_badge release %>
          </div>
        <% end %>
      <% else %>
        <div class="empty">
          <div class="empty-title">No releases yet</div>
          <div class="empty-hint"><%= link_to "Upload the first one", upload_admin_agent_releases_path %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
