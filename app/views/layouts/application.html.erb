<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Stampezi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if signed_in? %>
      <nav class="topbar">
        <%= link_to "Shops", admin_shops_path %>
        <span class="spacer"></span>
        <span class="muted"><%= current_user.email %></span>
        <%= button_to "Sign out", logout_path, method: :delete, class: "linkish" %>
      </nav>
    <% end %>

    <% if flash[:notice] %><p class="flash ok"><%= flash[:notice] %></p><% end %>
    <% if flash[:alert] %><p class="flash bad"><%= flash[:alert] %></p><% end %>

    <%= yield %>
  </body>
</html>
